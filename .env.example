# Copy to .env to override defaults. Every setting is optional locally:
# defaults target `make up`. See packages/card_maven/src/card_maven/shared/config.py.
CARD_MAVEN_ENVIRONMENT=local
CARD_MAVEN_LOG_JSON=false
CARD_MAVEN_DATABASE_URL=postgresql+psycopg://card_maven:card_maven@localhost:5432/card_maven
CARD_MAVEN_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
CARD_MAVEN_OIDC_ISSUER=http://localhost:8080/realms/card-maven
CARD_MAVEN_OIDC_AUDIENCE=card-maven-api
CARD_MAVEN_OIDC_JWKS_URL=http://localhost:8080/realms/card-maven/protocol/openid-connect/certs
CARD_MAVEN_CORS_ORIGINS=["http://localhost:5173"]
